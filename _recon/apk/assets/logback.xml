<configuration>
    <!-- Properties -->
    <property name="LOG_DIR" value="${FILES_DIR}/logs" />
    <property name="LOG_PATTERN" value="%d{ISO8601}|%level|%logger{0}|%msg%n" />

    <!-- Single rolling file appender (3MB max, 2 backups like Windows) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/lumashare.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${LOG_DIR}/lumashare.log.%i</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>2</maxIndex>
        </rollingPolicy>

        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>3MB</maxFileSize>
        </triggeringPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Console for Debug builds -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{15} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger configuration -->
    <root level="TRACE">
        <appender-ref ref="FILE" />
        <!-- Console added programmatically for debug builds only -->
    </root>
</configuration>
